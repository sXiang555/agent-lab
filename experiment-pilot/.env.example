# 本地规则演示不需要任何密钥。生产模式关闭示例令牌。
PILOT_DEMO_AUTH=1
# PILOT_ANALYST_TOKEN=
# PILOT_REVIEWER_TOKEN=
# PILOT_RUNS_FILE=/absolute/path/to/runs.json
# PILOT_STATE_DIR=.state
# PILOT_DATABASE_URL=postgresql://pilot:pilot_local@127.0.0.1:5432/pilot
# PILOT_REQUESTS_PER_MINUTE=30

# 可选：OpenAI 兼容服务。模型须支持 JSON object 输出。
# PILOT_MODEL_BASE_URL=
# PILOT_MODEL_KEY=
# PILOT_SMALL_MODEL=
# PILOT_DRAFT_MODEL=
# PILOT_REASONING_EFFORT=none  # 仅在模型端点支持时开启
# PILOT_EMBEDDING_MODEL=
# PILOT_SMALL_PRICE=0.0,0.0
# PILOT_DRAFT_PRICE=0.0,0.0

# 可选：与 /rerank 接口兼容的服务
# PILOT_RERANK_URL=
# PILOT_RERANK_MODEL=
# PILOT_RERANK_KEY=

# 可选：Langfuse，仅发送阶段名、复盘和轮次 ID
# PILOT_LANGFUSE=1
# LANGFUSE_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
